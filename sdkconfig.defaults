#
# Only what differs from espOS. espos/cmake/espos_project.cmake puts
# espos/sdkconfig.d/espos.defaults (+ .<target>) on SDKCONFIG_DEFAULTS ahead
# of this file, so flash/OTA/signing, logging, the HTTP server and the task
# stacks are inherited and a line here is an override, never a mirror.
# Defaults reach a FRESH sdkconfig only: delete build*/sdkconfig after
# changing anything here or in espOS's fragments.

# The plotter's directory and file names are longer than 8.3.
CONFIG_FATFS_LFN_HEAP=y
# The class TinyUSB presents; esp_tinyusb compiles nothing for it otherwise.
CONFIG_TINYUSB_MSC_ENABLED=y
# What the plotter shows the card as.
CONFIG_TINYUSB_DESC_PRODUCT_STRING="espOS bathy bridge"
